# Client Settings
BROWSER=none
PORT=3000

# Server Settings
SERVER_PORT=5000

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Your Gmail address used to send the emails
EMAIL_USER=your_email@gmail.com

# 16-character Google App Password (NOT your normal Gmail password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_PASS=your_gmail_app_password

# The inbox where contact form inquiries should be delivered
CONTACT_RECEIVER=your_email@gmail.com

# Optional: Set to 'false' if you do not want to send auto-reply confirmation to visitors
SEND_VISITOR_CONFIRMATION=true
